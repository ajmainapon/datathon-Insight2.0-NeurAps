{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "<absolute-path-to-repo>/memory/knowledge-graph.jsonl"
      }
    },
    "powerpoint": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "--from",
        "office-powerpoint-mcp-server",
        "ppt_mcp_server"
      ]
    },
    "kaggle": {
      "command": "uvx",
      "args": [
        "kaggle-mcp"
      ],
      "env": {
        "KAGGLE_USERNAME": "<your-kaggle-username>",
        "KAGGLE_KEY": "<your-kaggle-key>"
      }
    }
  }
}